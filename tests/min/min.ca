
use <stdio.h>;

void print_val(int* v) {
    printf("%d\n", *v);
}

// received a mutable pointer int!* pointer
void mod_val(int!* v) {
    *v = *v + 42;
}

int main() {
    int x = 10;         // Declare an integer variable
    int!* p = &!x; // take a mutable pointer
    mod_val(p);
    print_val(p);       // Declare a pointer and assign it the address of x
    return 0;
}
